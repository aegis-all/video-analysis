# =============================================================
#  GitHub に上げてはいけないもの
#
#  data/ には案件の動画（294MB）・スクリーンショット・データベース・
#  ログイン用の署名鍵が入っている。
#  GitHub は 1ファイル100MB までなので動画は弾かれるうえ、
#  署名鍵が漏れると誰でもログインできてしまう。まるごと除外する。
# =============================================================

data/

# 接続情報。絶対に上げない
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# エディタ・OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 作業中に出たもの
*.bak
*.bak-*
*.before-*
*.log
node_modules/
